# linear-clone environment
#
# Copy to .env.local and fill in what you need:
#   cp .env.example .env.local
#
# Everything here is optional. v0 has no server or database; the only
# integration that reads environment variables is Clerk auth
# (lib/auth.ts and proxy.ts key off NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY).

# ---------------------------------------------------------------------------
# Clerk authentication (optional)
#
# Without these the app runs in open demo mode: no route protection and a
# seeded demo user in the sidebar. With both set, all app routes require
# sign in and the sidebar shows the real Clerk user.
# Create an application at https://dashboard.clerk.com and copy both keys.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk route overrides, read by @clerk/nextjs (defaults shown; only
# needed if the auth pages move).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where Clerk lands users after auth when no redirect is present.
# The app already redirects / to /my-issues, so these stay commented
# unless you want a different destination.
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ---------------------------------------------------------------------------
# XO integration
#
# The app mirrors todos and work items from .xo folders on disk (read
# only). XO_ROOT is the folder whose .xo directory and project folders
# get scanned. When unset, the server walks up from the app directory
# and uses the topmost ancestor containing a .xo directory. The Setup
# dialog in the app can override this per browser without restarting.
# ---------------------------------------------------------------------------
# XO_ROOT=/Users/you/Programming/XO/ClaudeWorkspace
