#!/usr/bin/env node
// Archive finished experiments. Each named branch becomes the next commit on the
// archive branch: that commit adds the branch's files under <name>/ and keeps the
// branch's whole history as its second parent. Then the branch is deleted and the
// index on main lists the experiment as archived.
//
//   ./archive trees              archive one experiment
//   ./archive trees nirvana      several at once, one commit each
//   ./archive --dry-run trees    show what would happen; write and push nothing
//   ./archive --force trees      archive the published version even if the folder changed since
'use strict'

const fs = require('node:fs')
const path = require('node:path')
const { ROOT, RESERVED, git, run, die, entries, count, day, repoUrl, loadManifest, remoteBranches, syncMain, snapshot, saveIndex } =
  require('./publish')

const BRANCH = 'archive'

const hasCommit = (sha) => git(['cat-file', '-e', `${sha}^{commit}`], { ok: true }) !== null
const treeOf = (sha) => git(['rev-parse', `${sha}^{tree}`]).trim()
const commit = (tree, parents, message) =>
  git(['commit-tree', tree, ...parents.flatMap((p) => ['-p', p]), '-F', '-'], { input: message }).trim()

// The archive branch's first commit: a README saying how it works.
function startArchive() {
  const readme = [
    '# archive',
    '',
    'Finished experiments. Each one is a folder here, added by the commit that archived it.',
    "That commit's second parent is the experiment's old branch, so its whole history stays reachable after the branch is deleted.",
    '',
    '```bash',
    'git log --first-parent --oneline archive   # one line per archived experiment',
    '```',
    '',
    `Live experiments and the full index: ${repoUrl()}`,
    '',
  ].join('\n')
  const blob = git(['hash-object', '-w', '--stdin'], { input: readme }).trim()
  const tree = git(['mktree'], { input: `100644 blob ${blob}\tREADME.md\n` }).trim()
  return commit(tree, [], 'Start the archive\n')
}

// The tree of `tip` with <name>/ set to `tree`; archiving a name again replaces its folder.
function withFolder(tip, name, tree) {
  const rows = entries(git(['ls-tree', '-z', tip])).filter((row) => row.slice(row.indexOf('\t') + 1) !== name)
  rows.push(`040000 tree ${tree}\t${name}`)
  return git(['mktree', '-z'], { input: rows.map((row) => `${row}\0`).join('') }).trim()
}

function main() {
  const argv = process.argv.slice(2)
  const dryRun = argv.includes('--dry-run')
  const force = argv.includes('--force')
  const names = [...new Set(argv.filter((a) => !a.startsWith('--')))]
  if (!names.length) die('Name the experiments to archive, for example: ./archive trees')

  const manifest = loadManifest()
  const remote = remoteBranches()
  for (const name of names) {
    if (RESERVED.has(name)) die(`"${name}" is not an experiment.`)
    if (!remote.has(name)) die(`There is no "${name}" branch on origin.`)
  }
  if (!dryRun) syncMain(remote)

  // Everything the new commits build on has to be here locally.
  const missing = [BRANCH, ...names].filter((b) => remote.has(b) && !hasCommit(remote.get(b)))
  if (missing.length) git(['fetch', '-q', 'origin', ...missing.map((b) => `refs/heads/${b}:refs/remotes/origin/${b}`)])

  // Work that never got published would not make it into the archive.
  if (!force) {
    for (const name of names) {
      if (!fs.existsSync(path.join(ROOT, name))) continue
      const snap = snapshot(name, manifest)
      if (snap && snap.tree !== treeOf(remote.get(name))) {
        die(`${name} has changes that were never published. Run ./publish ${name} first, or use --force to archive the published version.`)
      }
    }
  }

  let tip = remote.get(BRANCH) ?? startArchive()
  const report = []
  for (const name of names) {
    const head = remote.get(name)
    const description = manifest.experiments[name]?.description
    const message = [
      `Archive ${name}`,
      '',
      ...(description ? [description, ''] : []),
      `The ${name} branch moved here: its files are in ${name}/ and its history is`,
      `this commit's second parent. Last commit on the branch: ${head.slice(0, 7)}.`,
      '',
    ].join('\n')
    tip = commit(withFolder(tip, name, treeOf(head)), [tip, head], message)
    const history = count(Number(git(['rev-list', '--count', head]).trim()), 'commit')
    report.push(`  ${name.padEnd(26)} ${(dryRun ? 'would archive' : 'archived').padEnd(13)} ${history} of history, now ${BRANCH}/${name}/`)
  }
  if (dryRun) return console.log(`${report.join('\n')}\n\nDry run: nothing was written or pushed.`)

  // One atomic push: archive moves forward and the branches go, or nothing changes.
  // The leases make sure no branch moved since we read it.
  const leases = names.map((name) => `--force-with-lease=refs/heads/${name}:${remote.get(name)}`)
  const refs = [`${tip}:refs/heads/${BRANCH}`, ...names.map((name) => `:refs/heads/${name}`)]
  const push = run(['push', '--atomic', '-q', ...leases, 'origin', ...refs])
  if (push.status !== 0) die(`Push failed, so nothing was archived:\n${push.stderr.toString().trim()}`)
  console.log(report.join('\n'))
  git(['update-ref', `refs/heads/${BRANCH}`, tip])
  git(['update-ref', `refs/remotes/origin/${BRANCH}`, tip])
  for (const name of names) {
    git(['update-ref', '-d', `refs/heads/${name}`], { ok: true })
    git(['update-ref', '-d', `refs/remotes/origin/${name}`], { ok: true })
  }

  const today = day(new Date())
  for (const name of names) {
    manifest.archived[name] = { ...manifest.experiments[name], archived: today }
    delete manifest.experiments[name]
  }
  const live = new Set([...remote.keys(), BRANCH].filter((branch) => !names.includes(branch)))
  saveIndex(manifest, live, `Archive ${names.join(', ')}`)
  console.log(`\n${count(names.length, 'experiment')} archived. Local folders are untouched, and ./publish now skips them.`)
}

main()
