{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task_definition.schema.json",
  "title": "TaskDefinition",
  "type": "object",
  "required": ["schema_version", "task_id", "title", "category", "difficulty", "max_seconds", "prompt", "acceptance_criteria"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "task_id": { "type": "string", "pattern": "^T[0-9]{2}$" },
    "title": { "type": "string" },
    "category": { "type": "string", "enum": ["feature", "bugfix", "refactor", "test", "documentation"] },
    "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
    "max_seconds": { "type": "integer", "minimum": 60, "maximum": 7200 },
    "estimated_tokens_baseline": { "type": ["integer", "null"] },

    "prompt": { "type": "string", "minLength": 20 },

    "acceptance_criteria": {
      "type": "object",
      "required": ["automated"],
      "additionalProperties": false,
      "properties": {
        "automated": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "type", "command", "pass_condition"],
            "additionalProperties": false,
            "properties": {
              "id":             { "type": "string", "pattern": "^AC[0-9]+$" },
              "type":           { "type": "string", "enum": ["pytest", "shell", "regex", "ast_check"] },
              "command":        { "type": "string" },
              "pass_condition": { "type": "string" },
              "timeout_seconds":{ "type": ["integer", "null"] }
            }
          }
        },
        "human": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description", "rubric"],
            "additionalProperties": false,
            "properties": {
              "id":          { "type": "string", "pattern": "^AC[0-9]+$" },
              "description": { "type": "string" },
              "rubric":      { "type": "string", "enum": ["binary", "0-3"] }
            }
          }
        }
      }
    },

    "reference_files": {
      "type": "array",
      "items": { "type": "string" }
    },

    "ground_truth_tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "E0_median":  { "type": ["integer", "null"] },
        "oracle_min": { "type": ["integer", "null"] }
      }
    }
  }
}
